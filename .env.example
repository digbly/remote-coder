APP_NAME=remote-coder
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Proof-of-work gate on login (anti-bot). The client must find a nonce whose
# SHA-256 challenge digest starts with POW_DIFFICULTY zero hex nibbles.
# Set POW_ENABLED=false to turn the challenge off.
POW_ENABLED=true
POW_DIFFICULTY=4

# Generate with:
# .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep stable and secret; changing this key requires re-entering saved AI provider keys.
AI_CREDENTIAL_ENCRYPTION_KEY=
